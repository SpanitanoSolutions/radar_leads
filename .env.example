# Conexión a Postgres (en Neon: "Connection string", versión pooled)
DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require

# Contraseña con la que entra tu papá
APP_PASSWORD=elegi-una-clave-larga

# Texto aleatorio largo para firmar la sesión. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Clave con la que Vercel Cron llama a /api/cron/... (se genera igual que
# SESSION_SECRET). Sin ella el endpoint rechaza todos los pedidos.
CRON_SECRET=

# Token bearer de 32 bytes para el proceso que informa resultados de portales.
# Generarlo con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# No lo compartas por chat; cargar el mismo valor en el worker y en el entorno.
# El worker informa por POST /api/agentes/cotizacion/resultado con solicitudId,
# compania, precio y observacion opcional.
COTIZACION_WEBHOOK_SECRET=

# Clave base64 de 32 bytes para cifrar credenciales de portales con AES-256-GCM.
# Generarla con node -e "console.log(require('crypto').randomBytes(32).toString('base64'))".
COTIZACION_CREDENTIALS_KEY=

# API key de Anthropic (console.anthropic.com) para buscar el teléfono de cada
# empresa con Claude. Sin ella esa búsqueda no corre; el resto funciona igual.
ANTHROPIC_API_KEY=

# Nombre del productor para el saludo del guion de contacto (opcional).
NOMBRE_PRODUCTOR=

# Google Maps (Places API) para buscar el contacto de cada empresa nueva.
# Sin la key no se busca nada. El límite controla el costo diario.
GOOGLE_PLACES_API_KEY=
PLACES_LIMITE_DIARIO=50

# Resumen diario por email (Resend). Sin la key, el resumen solo se ve en /resumen.
RESEND_API_KEY=
# Uno o varios destinatarios separados por coma.
RESUMEN_EMAIL_DESTINO=
# Opcional: remitente con un dominio verificado en Resend (si no, onboarding@resend.dev,
# que solo entrega al email de la cuenta de Resend).
RESUMEN_EMAIL_REMITENTE=
# Opcional: URL pública para los enlaces del email (en Vercel se toma sola).
APP_URL=

# Google OAuth. Registrar estos callbacks en la consola de Google:
# {APP_URL}/api/conexiones/oauth/gmail
# {APP_URL}/api/conexiones/oauth/google-calendar
# Gmail pide permiso de envio y lectura de adjuntos; Google puede exigir
# verificacion de la pantalla de consentimiento para esos alcances.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth de la aplicacion Mercado Pago. Callback:
# {APP_URL}/api/conexiones/oauth/mercadopago
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# WhatsApp Business Cloud API. Solo el entorno del servidor guarda el token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=
# Opcional: nombre e idioma de una plantilla aprobada con una sola variable
# de texto en el cuerpo, necesaria para iniciar conversaciones.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
# Conectores de compañías simulados (SimuladaApi y SimuladaPortal). Solo desarrollo y E2E; se ignora en producción.
CONECTORES_SIMULADOS=
